{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SingleProduct",
  "type": "object",
  "required": ["id", "name", "price", "images"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "slug": {"type": "string"},
    "description": {"type": "string"},
    "price": {"type": "string"},
    "compareAtPrice": {"type": ["string", "null"]},
    "stockQuantity": {"type": "integer"},
    "sku": {"type": "string"},
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "categoryId": {"type": "string"},
    "isActive": {"type": "boolean"},
    "createdAt": {"type": "string"}
  }
}

