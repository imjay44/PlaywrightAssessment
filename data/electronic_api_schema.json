{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ElectronicProduct",
  "type": "object",
  "required": ["id", "name", "price", "image"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string", "minLength": 1},
    "price": {"type": "string"},
    "image": {"type": "string"},
    "description": {"type": "string"},
    "brand": {"type": "string"},
    "category": {"type": "string"},
    "rating": {"type": "string"},
    "stock": {"type": "string"},
    "createdAt": {"type": "string"}
  }
}

